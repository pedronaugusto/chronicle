{
  "land": true,
  "attest": true,
  "compile_step": "check",
  "targets": [
    "x86_64-linux-gnu",
    "aarch64-linux-gnu",
    "x86_64-linux-musl",
    "x86_64-windows-gnu",
    "aarch64-windows-gnu",
    "x86_64-macos",
    "aarch64-macos",
    {
      "target": "x86_64-linux-gnu",
      "cpu": "x86_64_v2"
    },
    {
      "target": "aarch64-linux-gnu",
      "cpu": "cortex_a72"
    }
  ],
  "compile_once": false,
  "jobs": [
    {
      "name": "ThreadSanitizer (Linux)",
      "step": "test",
      "args": ["-Dthread-sanitizer=true", "-Doptimize=debug", "-Dci-lint=false"],
      "tiers": ["release"]
    }
  ]
}
