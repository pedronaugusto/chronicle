# Everything this repository holds is LF on every platform, so no diff and no
# gate ever reads a line ending as a change.
* text=auto eol=lf

# The journals a previous version wrote, byte for byte.
src/testdata/**/*.log binary
src/testdata/**/*.idx binary

# Two changes that add lines under one group of CHANGELOG.md both keep them, with no
# conflict to resolve; `bay release` orders the section.
CHANGELOG.md merge=union
